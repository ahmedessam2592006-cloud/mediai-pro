{
  "version": 2,
  "name": "mediai-pro",
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/gemini", "dest": "/api/gemini.js" },
    { "src": "/api/search", "dest": "/api/search.js" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
